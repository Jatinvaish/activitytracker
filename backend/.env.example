# Copy to backend/.env for local runs (never commit .env), then: node --env-file=.env server.js
# On Render, set the same keys under Environment.

PORT=3056

# Shared key the desktop app uses to register a computer (must match the app's TRACKER_API_SECRET)
API_SECRET=replace_with_a_long_random_string

# Password for the admin console at /admin (keep it different from API_SECRET)
ADMIN_KEY=replace_with_another_long_random_string

# Supabase project (Project Settings → API). Use the secret key, never the publishable one.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Business timezone for dates, emails and attendance
APP_TIMEZONE=Asia/Kolkata

# Email for adjustment requests and new-computer approvals (Gmail needs an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
