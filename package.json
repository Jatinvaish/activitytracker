{
  "name": "activity-utility",
  "version": "1.0.19",
  "description": "Activity tracker with Google Sheets, email, and CRM integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/tracker.test.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.activityutility.tracker",
    "productName": "Activity Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**/*",
      "index.html",
      "prompt.html",
      "package.json",
      "node_modules/**/*",
      "!node_modules/koffi/{src,doc,vendor}/**",
      "!**/*.env*",
      "!nextjscrud-*.json",
      "!backend/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Jatinvaish",
      "repo": "activitytracker"
    },
    "win": {
      "files": [
        "main.js", "app/**/*", "index.html", "prompt.html", "package.json", "node_modules/**/*",
        "!node_modules/koffi/{src,doc,vendor}/**", "!**/*.env*", "!nextjscrud-*.json", "!backend/**",
        "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "files": [
        "main.js", "app/**/*", "index.html", "prompt.html", "package.json", "node_modules/**/*",
        "!node_modules/koffi/{src,doc,vendor}/**", "!**/*.env*", "!nextjscrud-*.json", "!backend/**",
        "!node_modules/koffi/build/koffi/{darwin,freebsd,win32,openbsd}_*/**"
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "mac": {
      "files": [
        "main.js", "app/**/*", "index.html", "prompt.html", "package.json", "node_modules/**/*",
        "!node_modules/koffi/{src,doc,vendor}/**", "!**/*.env*", "!nextjscrud-*.json", "!backend/**",
        "!node_modules/koffi/build/koffi/{freebsd,linux,musl,win32,openbsd}_*/**"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    }
  },
  "author": {
    "name": "Jatin Vaishnav",
    "email": "1195jatinvaishnav@gmail.com"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "bytenode": "^2.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
